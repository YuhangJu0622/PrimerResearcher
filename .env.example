JINA_API_KEYS=
TOOL_SUMMARY_BASE_URL=
TOOL_SUMMARY_API_KEY=
TOOL_SUMMARY_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=qwen3.5-plus
